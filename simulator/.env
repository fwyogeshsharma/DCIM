# ── DCIM Simulator Environment Variables ─────────────────────────────────────
# Copy this to .env and customize before running docker-compose

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=dcim
POSTGRES_PASSWORD=dcim_pas
POSTGRES_DB=dcim_aggregator

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── DCIM Server ports (host-side) ─────────────────────────────────────────────
DCIM_SERVER_A_PORT=8081
DCIM_SERVER_B_PORT=8082
DCIM_SERVER_C_PORT=8083

# ── Aggregator ────────────────────────────────────────────────────────────────
AGGREGATOR_PORT=3002

# ── UI ────────────────────────────────────────────────────────────────────────
UI_PORT=5173
PROXY_PORT=3001

# ── Simulator fault API ports (host-side) ────────────────────────────────────
SIM_A_API_PORT=8090
SIM_B_API_PORT=8091
SIM_C_API_PORT=8092

# ── Orchestrator ─────────────────────────────────────────────────────────────
ORCHESTRATOR_PORT=8099

# ── Network configs (override per-container if needed) ────────────────────────
# SIM_A_CONFIG=/app/config/network-a.yaml
# SIM_B_CONFIG=/app/config/network-b.yaml
# SIM_C_CONFIG=/app/config/network-c.yaml

# ── sFlow collector (default: aggregator container) ──────────────────────────
SFLOW_COLLECTOR_IP=aggregator
SFLOW_COLLECTOR_PORT=6343

# ── SNMP trap receiver ────────────────────────────────────────────────────────
TRAP_RECEIVER_IP=aggregator
TRAP_RECEIVER_PORT=162
