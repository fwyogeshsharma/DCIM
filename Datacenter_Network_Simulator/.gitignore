# ── Secrets — never commit ───────────────────────────────────────────────────
auth.env
auth_users.json

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Build / packaging output ─────────────────────────────────────────────────
build/
dist/
*.manifest

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Generated runtime data ───────────────────────────────────────────────────
datasets/

# ── Claude Code traces ───────────────────────────────────────────────────────
.claude/
.claude.json
CLAUDE.md
CLAUDE.local.md

# ── graphify traces (regenerate with `graphify update .`) ─────────────────────
graphify-out/
.graphify*

# ── IDE / editor ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Note: webui/ has its own .gitignore for node_modules/, dist/, etc.
