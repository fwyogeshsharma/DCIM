# Authentication credentials for the REST API / Web UI.
#
# Copy to auth.env (which run.sh auto-loads) and fill in real values:
#     cp auth.env.example auth.env
#     .venv/bin/python -m api.auth set-password   # prints the two values below
#     chmod 600 auth.env
#
# auth.env is gitignored — never commit real secrets.
#
# IMPORTANT: use SINGLE quotes. run.sh sources this file, and the PBKDF2 hash
# contains '$' characters that double quotes would let the shell expand (and
# destroy). Single quotes keep every character literal.

# Required. JWT signing secret. Generate with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Reuse the SAME value across restarts or all existing logins are invalidated.
DCIM_AUTH_SECRET=''

# Single-user mode: PBKDF2 hash of the shared password (username defaults to "admin").
# Produced by `python -m api.auth set-password`.
# NOT needed if you use multi-user mode (auth_users.json) — leave empty then.
# MUST be single-quoted — the hash contains '$' separators.
DCIM_AUTH_PASSWORD_HASH=''

# Optional overrides:
# DCIM_AUTH_USERNAME="admin"          # bootstrap username for single-user mode
# DCIM_AUTH_TTL_HOURS="12"            # token lifetime
# DCIM_AUTH_USERS_FILE="auth_users.json"   # multi-user store path
