# API Configuration — use relative paths so they work behind any hostname/IP
# Vite proxy routes /api → localhost:3001 (proxy-server.js) inside the container
VITE_API_URL=/api/v1
VITE_AI_API_URL=/ai

# OpenAI Configuration (for Natural Language Queries)
# VITE_OPENAI_API_KEY=sk-your-openai-api-key-here
