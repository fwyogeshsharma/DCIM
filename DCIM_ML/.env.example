# DCIM_ML configuration (copy to .env for local runs).
# In docker-compose these are injected by the dcim-ml service block.

# ── TimescaleDB (shared with the aggregator) ──────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5435            # 5435 from host, 5432 inside the docker network
POSTGRES_DB=dcim_aggregator
POSTGRES_USER=dcim
POSTGRES_PASSWORD=dcim_pas

# ── Service ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
MODEL_PATH=./models

# ── Capacity assumptions (no dedicated rack table yet) ────────────────────────
RACK_U_DEFAULT=42                 # rack height in U when not otherwise known
RACK_POWER_CAPACITY_W=10000       # per-rack power budget (W) for headroom calc

# ── Forecasting ───────────────────────────────────────────────────────────────
FORECAST_HORIZONS=30,60,90        # days
# Utilization thresholds (%) used to derive exhaustion dates / recommendations
CPU_THRESHOLD_PCT=85
MEM_THRESHOLD_PCT=85
RACK_WARN_PCT=95

# ── Retraining ────────────────────────────────────────────────────────────────
RETRAIN_CRON=0 2 * * *            # daily at 02:00 (server time)
RUN_ON_STARTUP=true               # run a pipeline pass at boot if last run is stale
STALE_RUN_HOURS=20                # consider the last run stale after N hours
